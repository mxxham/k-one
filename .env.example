# K-one environment configuration.
# Copy this file to `.env` and adjust for your machine.
# Keys mirror v2 `apps/api/src/config/config.service.ts`; MariaDB/MySQL
# defaults are pre-filled for the local XAMPP stack (sanchaya).

# --- HTTP ---
PORT=3000

# --- Database (MariaDB/MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sanchaya
DB_USER=root
DB_PASS=

# --- Redis (reserved for parity; unused in the sync-only PHP port) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET=k-one-dev-secret-change-me
JWT_EXPIRES_HOURS=12

# --- App ---
TIMEZONE=Asia/Jakarta
API_ENV=dev

# --- Docker only (consumed by docker-compose.yml, not by the PHP app) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=sanchaya
APP_PORT=80
MYSQL_HOST_PORT=3307